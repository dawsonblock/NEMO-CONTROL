# Test and run state.
#
# The Crabedence CLI derives its repository root from `git rev-parse
# --show-toplevel`. Now that this repository is the root, running its suite
# from `crabedence-V1-fix-integration-integrity/` resolves that root here and
# writes run records into this directory — outside the subtree's own
# `.gitignore`. They are transient test state, never source.
.crabbox/

# OS state
.DS_Store

# Outer provenance snapshots and isolated test workspaces are release output.
/.outer-provenance-*
/crabedence-V1-fix-integration-integrity/scripts/.outer-provenance-tests-*/
/.outer-release/
